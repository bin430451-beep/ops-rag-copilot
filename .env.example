# ===== 基础 =====
APP_ENV=prod
LOG_LEVEL=INFO
ALLOWED_IPS=10.0.0.0/8,192.168.0.0/16,127.0.0.1
API_KEYS=change-me-please
# ===== Qdrant =====
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=ops_kb
# ===== Embedding =====
EMBEDDING_BASE_URL=http://embedding:8080/v1
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
EMBEDDING_API_KEY=EMPTY
EMBEDDING_DIM=1024
# ===== LLM =====
LLM_BASE_URL=http://llm:8000/v1
LLM_MODEL=Qwen2.5-14B-Instruct
LLM_API_KEY=EMPTY
LLM_TIMEOUT=120
# ===== Reranker =====
RERANK_ENABLED=true
RERANK_URL=http://reranker:8080/rerank
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=5
# ===== 检索参数 =====
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVE_TOP_K=20
# ===== 存储 =====
META_DB_PATH=/data/meta.db
UPLOAD_DIR=/data/uploads
